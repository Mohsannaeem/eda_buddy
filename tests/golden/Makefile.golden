## ======================================================
## UTILITIES
## ======================================================
.PHONY: clean report
clean:
	rm -rf $(ROOT)/*/build $(ROOT)/*/work $(ROOT)/*/run
	@echo 'Cleaned per-component build/work/run dirs. Filelists and Makefile preserved.'

## REPORT — scan all run logs and print pass/fail summary
report:
	@if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --root $(ROOT) --project-name "GOLDEN_FIXTURE_PROJECT" --save-to $(ROOT)/logs/report.txt; else printf '\033[1m[EDA Buddy] Report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi
