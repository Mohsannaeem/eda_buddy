## ======================================================
## COMPONENT: comp_b
## ======================================================
comp_b_FLIST := $(FLIST_DIR)/comp_b.f
comp_b_TOP   := comp_b_tb_top

xcelium_build_comp_b:
	@echo "[PRE-BUILD-GLOBAL] echo global-pre"
	@echo global-pre
	@mkdir -p $(COMP_B_BUILD_DIR)
	@echo "[XCELIUM] Building comp_b — log: $(COMP_B_BUILD_DIR)/xcelium.log"
	xrun -sv -uvm -top comp_b_tb_top -xmlibdirpath $(COMP_B_BUILD_DIR) -f $(comp_b_FLIST) 2>&1 | tee $(COMP_B_BUILD_DIR)/xcelium.log
	@echo "[POST-BUILD-GLOBAL] echo global-post"
	@echo global-post

## -- Runtime verbosity (default from run.yaml; override: make ... VERBOSITY=UVM_HIGH) --
COMP_B_VERBOSITY ?= UVM_MEDIUM

## -- Runtime debug defaults (from run.yaml; override on the make line) --
COMP_B_WAVES       ?= 0
COMP_B_GUI         ?= 0
COMP_B_QUIET       ?= 1
COMP_B_WAVE_FORMAT ?= vcd

COMP_B_REDIRECT = $(if $(filter 1,$(if $(QUIET),$(QUIET),$(COMP_B_QUIET))),> $$LOGFILE 2>&1,2>&1 | tee $$LOGFILE)

vcs_run_comp_b_comp_b_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_b_base_test; else mkdir -p $(COMP_B_RUN_DIR)/comp_b_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_B_RUN_DIR)/comp_b_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[VCS] Running comp_b_base_test"; \
	 VCD_ARGS=""; if [ "$(if $(WAVES),$(WAVES),$(COMP_B_WAVES))" = "1" ]; then VCD_ARGS="+vcs+dumpvars+$$RUN_DIR/waves.vcd"; fi; \
	 GUI_FLAG=""; if [ "$(if $(GUI),$(GUI),$(COMP_B_GUI))" = "1" ]; then GUI_FLAG="-gui"; fi; \
	 $(COMP_B_BUILD_DIR)/simv $$GUI_FLAG $$VCD_ARGS +UVM_TESTNAME=comp_b_base_test +ntb_random_seed=random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_B_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=1   $(COMP_B_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_b_base_test --total $(if $(TOTAL),$(TOTAL),1) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

questa_run_comp_b_comp_b_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_b_base_test; else mkdir -p $(COMP_B_RUN_DIR)/comp_b_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_B_RUN_DIR)/comp_b_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[QUESTA] Running comp_b_base_test"; \
	 DO_CMD="run -all; quit"; WLF_ARGS=""; \
	 if [ "$(if $(WAVES),$(WAVES),$(COMP_B_WAVES))" = "1" ]; then \
	   if [ "$(if $(WAVE_FORMAT),$(WAVE_FORMAT),$(COMP_B_WAVE_FORMAT))" = "wlf" ]; then \
	     WLF_ARGS="-wlf $$RUN_DIR/waves.wlf"; DO_CMD="log -r /*; run -all; quit"; \
	   else \
	     DO_CMD="vcd file $$RUN_DIR/waves.vcd; vcd add -r /*; run -all; quit"; \
	   fi; \
	 fi; \
	 if [ "$(if $(GUI),$(GUI),$(COMP_B_GUI))" = "1" ]; then DO_CMD="add wave -r /*; run -all"; fi; \
	 MODE="-batch"; if [ "$(if $(GUI),$(GUI),$(COMP_B_GUI))" = "1" ]; then MODE="-gui"; fi; \
	 vsim $$MODE $$WLF_ARGS -do "$$DO_CMD"  -lib $(COMP_B_WORK_DIR) db_opt +UVM_TESTNAME=comp_b_base_test -sv_seed random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_B_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=1  $(COMP_B_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_b_base_test --total $(if $(TOTAL),$(TOTAL),1) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

xcelium_run_comp_b_comp_b_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_b_base_test; else mkdir -p $(COMP_B_RUN_DIR)/comp_b_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_B_RUN_DIR)/comp_b_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[XCELIUM] Running comp_b_base_test"; \
	 $(COMP_B_BUILD_DIR)/simv +UVM_TESTNAME=comp_b_base_test -svseed random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_B_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=1 -licqueue  $(COMP_B_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_b_base_test --total $(if $(TOTAL),$(TOTAL),1) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

.PHONY: vcs_run_comp_b_nightly
vcs_run_comp_b_nightly:
	@echo "[PRE-NIGHTLY] echo comp_b-pre-nightly"
	@echo comp_b-pre-nightly
	@REGDIR="$(COMP_B_RUN_DIR)/nightly_$$(date +%Y%m%d_%H%M%S)"; \
	mkdir -p "$$REGDIR"; \
	echo "[NIGHTLY] Session dir: $$REGDIR  Total=1 tests"; \
	$(MAKE) -k $(PARALLEL_FLAGS) REGDIR=$$REGDIR TOTAL=1 vcs_run_comp_b_comp_b_base_test || true; \
	echo ""; \
	if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --root $(ROOT) --component comp_b --project-name "GOLDEN_FIXTURE_PROJECT" --tests comp_b_base_test --reg-dir $$REGDIR --save-to $$REGDIR/report.txt --post-cmd "echo comp_b-post-nightly {total} {passed} {failed}" $(if $(filter 1,$(PUSH_RESULTS)),$(if $(if $(RMS_ID),$(RMS_ID),COMP_B_NIGHTLY),--rms-id $(if $(RMS_ID),$(RMS_ID),COMP_B_NIGHTLY),),); else printf '\033[1m[EDA Buddy] Final report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi

.PHONY: questa_run_comp_b_nightly
questa_run_comp_b_nightly:
