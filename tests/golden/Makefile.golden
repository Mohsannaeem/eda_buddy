	 vsim $$MODE $$WLF_ARGS -do "$$DO_CMD" -suppress 3009 -lib $(COMP_A_WORK_DIR) db_opt +UVM_TESTNAME=comp_a_burst_test -sv_seed 12345 +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_A_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=10 +UVM_TIMEOUT=100000000 +BURST_LEN=16 $(COMP_A_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_a_burst_test --total $(if $(TOTAL),$(TOTAL),2) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
