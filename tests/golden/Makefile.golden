## AUTO-GENERATED BY EDA BUDDY — edit variables below to relocate the project
## eda-buddy-checksum: __CHECKSUM__

SHELL      := /bin/bash
.SHELLFLAGS := -o pipefail -c

## ======================================================
## PATHS — all paths derived from ROOT; override ROOT or
##          individual variables to relocate the project
## ======================================================
ROOT      := __ROOT__
FLIST_DIR := $(ROOT)/filelists

## -- EDA Buddy's own entry points --
## Invoked as modules rather than file paths: an installed package moves
## between venvs and site-packages, and a baked-in absolute path goes stale
## the first time it does. This form keeps working across reinstalls.

## Pinned to the interpreter that generated this file. A bare `python`
## resolves to Cygwin's own /usr/bin/python under Cygwin make — a separate
## installation, without eda_buddy — which silently disables all reporting.
## Written in mixed form (C:/...): Cygwin executes that directly, whereas a
## backslash path fails, and cygpath is not usable here because the one
## first on PATH may be MSYS's, which emits /c/... that Cygwin cannot resolve.
PYTHON     ?= __PYTHON__
REPORT_CMD := __EDA_BUDDY_SCRIPT__
PUSH_CMD   := __EDA_BUDDY_SCRIPT__

## Probe once at parse time: empty when EDA Buddy is not importable.
REPORT_OK  := __EDA_BUDDY_SCRIPT__

## NOTE: If EDA Buddy is not importable, reporting/RMS steps are silently
## skipped with a bold warning — builds and simulations continue.

## -- Parallel test execution within a regression group --
## Serial by default. `make <group target> JOBS=4` runs that group's tests
## concurrently; --output-sync keeps each test's output as one block instead
## of interleaving. Only the group's inner sub-make is affected — generation
## and build are always serial.
JOBS ?=
PARALLEL_FLAGS := $(if $(JOBS),-j$(JOBS) --output-sync=target,)

## -- Publishing results to the RMS --
## Opt-in. A group's rms_id only names the regression to push to;
## PUSH_RESULTS=1 is what actually publishes, so an ordinary local run
## never writes to the shared dashboard. RMS_ID overrides the target.
PUSH_RESULTS ?= 0
RMS_ID ?=

## -- Component path variables (build/work/run derive from ROOT) --
COMP_A_BUILD_DIR := $(ROOT)/comp_a/build
COMP_A_WORK_DIR  := $(ROOT)/comp_a/work
COMP_A_RUN_DIR   := $(ROOT)/comp_a/run
COMP_A_SRC_DIR   := __FIXDIR__/comp_a
COMP_B_BUILD_DIR := $(ROOT)/comp_b/build
COMP_B_WORK_DIR  := $(ROOT)/comp_b/work
COMP_B_RUN_DIR   := $(ROOT)/comp_b/run
COMP_B_SRC_DIR   := __FIXDIR__/comp_b

## -- Export source dirs so EDA tools expand them in filelists --
export COMP_A_SRC_DIR
export COMP_B_SRC_DIR

## ======================================================
## COMPONENT: comp_a
## ======================================================
comp_a_FLIST := $(FLIST_DIR)/comp_a.f
comp_a_TOP   := comp_a_tb_top

vcs_build_comp_a:
	@echo "[PRE-BUILD-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-BUILD] echo comp_a-pre-build"
	@echo comp_a-pre-build
	@mkdir -p $(COMP_A_BUILD_DIR)
	@echo "[VCS] Building comp_a — log: $(COMP_A_BUILD_DIR)/vcs.log"
	vlogan -sverilog -full64 +v2k -work comp_a_lib -f $(comp_a_FLIST) 2>&1 | tee $(COMP_A_BUILD_DIR)/vcs.log && \
	vcs -top comp_a_tb_top -o $(COMP_A_BUILD_DIR)/simv -Mdir=$(COMP_A_BUILD_DIR)/csrc 2>&1 | tee -a $(COMP_A_BUILD_DIR)/vcs.log
	@echo "[POST-BUILD] echo comp_a-post-build"
	@echo comp_a-post-build
	@echo "[POST-BUILD-GLOBAL] echo global-post"
	@echo global-post

questa_build_comp_a:
	@echo "[PRE-BUILD-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-BUILD] echo comp_a-pre-build"
	@echo comp_a-pre-build
	@mkdir -p $(COMP_A_BUILD_DIR) $(COMP_A_WORK_DIR)
	@echo "[QUESTA] Building comp_a — log: $(COMP_A_BUILD_DIR)/questa.log"
	vlib $(COMP_A_WORK_DIR) 2>&1 | tee $(COMP_A_BUILD_DIR)/questa.log && \
	vlog -work $(COMP_A_WORK_DIR) -sv -mfcu -timescale 1ns/1ps -f $(comp_a_FLIST) 2>&1 | tee -a $(COMP_A_BUILD_DIR)/questa.log && \
	vopt +acc comp_a_tb_top -o db_opt work.glbl -work $(COMP_A_WORK_DIR) 2>&1 | tee -a $(COMP_A_BUILD_DIR)/questa.log
	@echo "[POST-BUILD] echo comp_a-post-build"
	@echo comp_a-post-build
	@echo "[POST-BUILD-GLOBAL] echo global-post"
	@echo global-post

## -- Runtime verbosity (default from run.yaml; override: make ... VERBOSITY=UVM_HIGH) --
COMP_A_VERBOSITY ?= UVM_LOW

## -- Runtime debug defaults (from run.yaml; override on the make line) --
COMP_A_WAVES       ?= 1
COMP_A_GUI         ?= 0
COMP_A_QUIET       ?= 0
COMP_A_WAVE_FORMAT ?= wlf

COMP_A_REDIRECT = $(if $(filter 1,$(if $(QUIET),$(QUIET),$(COMP_A_QUIET))),> $$LOGFILE 2>&1,2>&1 | tee $$LOGFILE)

vcs_run_comp_a_comp_a_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-SIM] echo comp_a-pre-sim"
	@echo comp_a-pre-sim
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_a_base_test; else mkdir -p $(COMP_A_RUN_DIR)/comp_a_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_A_RUN_DIR)/comp_a_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[VCS] Running comp_a_base_test"; \
	 VCD_ARGS=""; if [ "$(if $(WAVES),$(WAVES),$(COMP_A_WAVES))" = "1" ]; then VCD_ARGS="+vcs+dumpvars+$$RUN_DIR/waves.vcd"; fi; \
	 GUI_FLAG=""; if [ "$(if $(GUI),$(GUI),$(COMP_A_GUI))" = "1" ]; then GUI_FLAG="-gui"; fi; \
	 $(COMP_A_BUILD_DIR)/simv $$GUI_FLAG $$VCD_ARGS +UVM_TESTNAME=comp_a_base_test +ntb_random_seed=random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_A_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=10 +UVM_TIMEOUT=100000000 -l simv.log  $(COMP_A_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_a_base_test --total $(if $(TOTAL),$(TOTAL),2) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM] echo comp_a-post-sim"
	@echo comp_a-post-sim
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

questa_run_comp_a_comp_a_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-SIM] echo comp_a-pre-sim"
	@echo comp_a-pre-sim
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_a_base_test; else mkdir -p $(COMP_A_RUN_DIR)/comp_a_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_A_RUN_DIR)/comp_a_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[QUESTA] Running comp_a_base_test"; \
	 DO_CMD="run -all; quit"; WLF_ARGS=""; \
	 if [ "$(if $(WAVES),$(WAVES),$(COMP_A_WAVES))" = "1" ]; then \
	   if [ "$(if $(WAVE_FORMAT),$(WAVE_FORMAT),$(COMP_A_WAVE_FORMAT))" = "wlf" ]; then \
	     WLF_ARGS="-wlf $$RUN_DIR/waves.wlf"; DO_CMD="log -r /*; run -all; quit"; \
	   else \
	     DO_CMD="vcd file $$RUN_DIR/waves.vcd; vcd add -r /*; run -all; quit"; \
	   fi; \
	 fi; \
	 if [ "$(if $(GUI),$(GUI),$(COMP_A_GUI))" = "1" ]; then DO_CMD="add wave -r /*; run -all"; fi; \
	 MODE="-batch"; if [ "$(if $(GUI),$(GUI),$(COMP_A_GUI))" = "1" ]; then MODE="-gui"; fi; \
	 vsim $$MODE $$WLF_ARGS -do "$$DO_CMD" -suppress 3009 -lib $(COMP_A_WORK_DIR) db_opt +UVM_TESTNAME=comp_a_base_test -sv_seed random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_A_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=10 +UVM_TIMEOUT=100000000  $(COMP_A_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_a_base_test --total $(if $(TOTAL),$(TOTAL),2) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM] echo comp_a-post-sim"
	@echo comp_a-post-sim
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

xcelium_run_comp_a_comp_a_base_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-SIM] echo comp_a-pre-sim"
	@echo comp_a-pre-sim
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_a_base_test; else mkdir -p $(COMP_A_RUN_DIR)/comp_a_base_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_A_RUN_DIR)/comp_a_base_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[XCELIUM] Running comp_a_base_test"; \
	 $(COMP_A_BUILD_DIR)/simv +UVM_TESTNAME=comp_a_base_test -svseed random +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_A_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=10 +UVM_TIMEOUT=100000000   $(COMP_A_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_a_base_test --total $(if $(TOTAL),$(TOTAL),2) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM] echo comp_a-post-sim"
	@echo comp_a-post-sim
	@echo "[POST-SIM-GLOBAL] echo global-post"
	@echo global-post

vcs_run_comp_a_comp_a_burst_test:
	@echo "[PRE-SIM-GLOBAL] echo global-pre"
	@echo global-pre
	@echo "[PRE-SIM] echo comp_a-pre-sim"
	@echo comp_a-pre-sim
	@if [ -n "$(REGDIR)" ]; then RUN_DIR=$(REGDIR)/comp_a_burst_test; else mkdir -p $(COMP_A_RUN_DIR)/comp_a_burst_test; RUN_ID=$$(date +%Y%m%d_%H%M%S); RUN_DIR=$(COMP_A_RUN_DIR)/comp_a_burst_test/run_$$RUN_ID; fi; mkdir -p $$RUN_DIR; LOGFILE=$$RUN_DIR/sim.log; \
	 echo "[VCS] Running comp_a_burst_test"; \
	 VCD_ARGS=""; if [ "$(if $(WAVES),$(WAVES),$(COMP_A_WAVES))" = "1" ]; then VCD_ARGS="+vcs+dumpvars+$$RUN_DIR/waves.vcd"; fi; \
	 GUI_FLAG=""; if [ "$(if $(GUI),$(GUI),$(COMP_A_GUI))" = "1" ]; then GUI_FLAG="-gui"; fi; \
	 $(COMP_A_BUILD_DIR)/simv $$GUI_FLAG $$VCD_ARGS +UVM_TESTNAME=comp_a_burst_test +ntb_random_seed=12345 +UVM_VERBOSITY=$(if $(VERBOSITY),$(VERBOSITY),$(COMP_A_VERBOSITY)) +RUN_DIR=$$RUN_DIR +UVM_MAX_QUIT_COUNT=10 +UVM_TIMEOUT=100000000 -l simv.log +BURST_LEN=16 $(COMP_A_REDIRECT); SIM_RC=$$?; if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --single-log $$LOGFILE --test-name comp_a_burst_test --total $(if $(TOTAL),$(TOTAL),2) $(if $(REGDIR),--comp-run-dir $(REGDIR),); else printf '\033[1m[EDA Buddy] Per-test report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi; exit $$SIM_RC
	@echo "[POST-SIM] echo comp_a-post-sim"
