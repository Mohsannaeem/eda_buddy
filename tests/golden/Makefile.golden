.PHONY: vcs_run_comp_a_smoke_test
vcs_run_comp_a_smoke_test:
	@REGDIR="$(COMP_A_RUN_DIR)/smoke_test_$$(date +%Y%m%d_%H%M%S)"; \
	mkdir -p "$$REGDIR"; \
	echo "[SMOKE_TEST] Session dir: $$REGDIR  Total=1 tests"; \
	$(MAKE) -k $(PARALLEL_FLAGS) REGDIR=$$REGDIR TOTAL=1 vcs_run_comp_a_comp_a_base_test || true; \
	echo ""; \
	if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --root $(ROOT) --component comp_a --project-name "GOLDEN_FIXTURE_PROJECT" --tests comp_a_base_test --reg-dir $$REGDIR --save-to $$REGDIR/report.txt  $(if $(filter 1,$(PUSH_RESULTS)),$(if $(RMS_ID),--rms-id $(RMS_ID),),); else printf '\033[1m[EDA Buddy] Final report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi

.PHONY: questa_run_comp_a_smoke_test
questa_run_comp_a_smoke_test:
	@REGDIR="$(COMP_A_RUN_DIR)/smoke_test_$$(date +%Y%m%d_%H%M%S)"; \
	mkdir -p "$$REGDIR"; \
	echo "[SMOKE_TEST] Session dir: $$REGDIR  Total=1 tests"; \
	$(MAKE) -k $(PARALLEL_FLAGS) REGDIR=$$REGDIR TOTAL=1 questa_run_comp_a_comp_a_base_test || true; \
	echo ""; \
	if [ -n "$(REPORT_OK)" ]; then $(REPORT_CMD) --root $(ROOT) --component comp_a --project-name "GOLDEN_FIXTURE_PROJECT" --tests comp_a_base_test --reg-dir $$REGDIR --save-to $$REGDIR/report.txt  $(if $(filter 1,$(PUSH_RESULTS)),$(if $(RMS_ID),--rms-id $(RMS_ID),),); else printf '\033[1m[EDA Buddy] Final report skipped: eda_buddy not importable. Run: pip install -e <path-to-eda_buddy>\033[0m\n'; fi

